    "newSource": "PREFIX : <http://ex/>\nSELECT ?s ?cell ?cols ?tail ?head WHERE {\n  ?s :matrix ?rows .\n  BIND(?rows[2][3] AS ?cell)\n  BIND(?rows[1][2...3] AS ?cols)\n  BIND(?rows[2...] AS ?tail)\n  BIND(?rows[...SEQLEN(?rows) - 1] AS ?head)\n  FILTER(-?rows[1][1] < 0 && !?rows[1][2])\n}\nORDER BY (?rows[1])\n",

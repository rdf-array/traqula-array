PREFIX : <http://ex/>
SELECT ?s ?cell ?cols ?tail ?head WHERE {
  ?s :matrix ?rows .
  BIND( ?rows[ "2"^^<http://www.w3.org/2001/XMLSchema#integer>][ "3"^^<http://www.w3.org/2001/XMLSchema#integer>] AS ?cell )
  BIND( ?rows[ "1"^^<http://www.w3.org/2001/XMLSchema#integer>][ "2"^^<http://www.w3.org/2001/XMLSchema#integer>... "3"^^<http://www.w3.org/2001/XMLSchema#integer>] AS ?cols )
  BIND( ?rows[ "2"^^<http://www.w3.org/2001/XMLSchema#integer>...] AS ?tail )
  BIND( ?rows[ "1"^^<http://www.w3.org/2001/XMLSchema#integer>... ( SEQLEN( ?rows ) - "1"^^<http://www.w3.org/2001/XMLSchema#integer> ) ] AS ?head )
  FILTER ( ( ( - ?rows[ "1"^^<http://www.w3.org/2001/XMLSchema#integer>][ "1"^^<http://www.w3.org/2001/XMLSchema#integer>] < "0"^^<http://www.w3.org/2001/XMLSchema#integer> ) && ! ?rows[ "1"^^<http://www.w3.org/2001/XMLSchema#integer>][ "2"^^<http://www.w3.org/2001/XMLSchema#integer>] ) )
}
ORDER BY ASC ( ?rows[ "1"^^<http://www.w3.org/2001/XMLSchema#integer>] )
PREFIX : <http://example.org/>
SELECT ?s ?cell ?len ?tail ?head WHERE {
  ?s :matrix ?rows .
  BIND(?rows[2][3] AS ?cell)
  BIND(SEQLEN(?rows[2]) AS ?len)
  BIND(?rows[2...] AS ?tail)
  BIND(?rows[...2] AS ?head)
  FILTER(isSEQ(?rows) && SEQ(3, 4) IN ?rows && ?s NOT IN ?rows[1] && ?rows = SEQ(SEQ(1, 2, 3), SEQ()))
}
ORDER BY (?rows[1])
